{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "printWidth": 180,
  "semi": true,
  "singleQuote": true,
  // Angular templates with the 2025 file naming (`login-page.html`) are not detected as Angular by default.
  "associations": [{ "files": ["projects/**/*.html"], "language": "angular-html" }],
  // The Spartan helm layer is generated (scripts/generate-helm.mjs) and keeps the generator's formatting.
  "ignorePatterns": [
    "node_modules",
    "dist",
    "out-tsc",
    ".angular",
    "coverage",
    "pnpm-lock.yaml",
    "projects/ng-base/ui/src/lib/helm/**",
    "projects/ng-base/ui/styles/components/**",
    "CHANGELOG.md",
  ],
}
