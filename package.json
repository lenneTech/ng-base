{
  "name": "@lenne.tech/ng-base",
  "version": "22.1.1",
  "private": true,
  "description": "Workspace of @lenne.tech/ng-base: Angular library for lenne.Tech projects (nest-server integration, Spartan UI) plus its playground app",
  "homepage": "https://github.com/lenneTech/ng-base",
  "license": "MIT",
  "author": "lenne.Tech <info@lenne.tech> (https://lenne.tech)",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "build": "node scripts/generate-ui-sources.mjs && ng build ng-base && node -e \"require('node:fs').copyFileSync('LICENSE', 'dist/ng-base/LICENSE')\"",
    "build:playground": "ng build playground",
    "dev": "ng serve playground --port 3001",
    "start": "ng serve playground --port 3001",
    "watch": "ng build ng-base --watch --configuration development",
    "test": "ng test ng-base --no-watch",
    "test:watch": "ng test ng-base",
    "test:e2e": "playwright test --config projects/playground/playwright.config.ts",
    "lint": "oxlint --type-aware --deny-warnings projects/ scripts/",
    "lint:fix": "oxlint --type-aware --fix projects/ scripts/",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc -p projects/ng-base/tsconfig.lib.json --noEmit && tsc -p projects/ng-base/tsconfig.spec.json --noEmit",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "check": "node scripts/check.mjs",
    "check:raw": "pnpm install --frozen-lockfile && pnpm audit --audit-level=high && pnpm run version:check && pnpm run check:workflow && pnpm run check:i18n && pnpm run ui-sources:check && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build && pnpm run check:manifest",
    "check:fix": "pnpm install && pnpm run version:sync && pnpm run check:workflow && pnpm run check:i18n && pnpm run ui-sources && pnpm run format && pnpm run lint:fix && pnpm run typecheck && pnpm test && pnpm run build && pnpm run check:manifest",
    "check:naf": "pnpm install && pnpm run version:sync && pnpm run check:workflow && pnpm run check:i18n && pnpm run ui-sources && pnpm run format && pnpm run lint:fix && pnpm run typecheck && pnpm test && pnpm run build && pnpm run check:manifest",
    "check:manifest": "node scripts/check-package-manifest.mjs",
    "check:workflow": "node scripts/check-publish-workflow.mjs",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "c": "pnpm run check",
    "cf": "pnpm run check:fix",
    "cnaf": "pnpm run check:naf",
    "pack": "pnpm run build && cd dist/ng-base && pnpm pack",
    "clean": "rm -rf dist out-tsc .angular node_modules",
    "reinit": "rm -rf node_modules pnpm-lock.yaml && pnpm install",
    "check:baseline": "node scripts/check-angular-baseline.mjs",
    "ui-sources": "node scripts/generate-ui-sources.mjs",
    "ui-sources:check": "node scripts/generate-ui-sources.mjs --check"
  },
  "dependencies": {
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/platform-server": "22.2.5",
    "@angular/router": "22.2.5",
    "@angular/ssr": "22.2.6",
    "@better-auth/passkey": "1.7.19",
    "@ng-icons/core": "36.1.0",
    "@ng-icons/lucide": "36.1.0",
    "@spartan-ng/brain": "1.9.0",
    "better-auth": "1.7.19",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "express": "5.3.0",
    "luxon": "3.7.2",
    "rxjs": "7.8.2",
    "tailwind-merge": "3.7.0",
    "tslib": "2.9.1",
    "tus-js-client": "4.3.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.6",
    "@types/node": "24.19.2",
    "fake-indexeddb": "6.2.8",
    "happy-dom": "21.0.4",
    "modern-screenshot": "4.7.0",
    "ng-packagr": "22.2.6",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "pnpm": "^11.0.0"
  },
  "packageManager": "pnpm@11.28.10+sha512.672216f06e15c109b85471d49d3fbed17e6f03ead258df08c2bf5b4a5c33321ebfbf59476bce81325efada16ace0ac78548fd0bfcd7a51369e939182a3dd50e4"
}
