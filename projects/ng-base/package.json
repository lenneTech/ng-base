{
  "name": "@lenne.tech/ng-base",
  "version": "22.0.2",
  "description": "Angular library for lenne.Tech projects: nest-server integration (Better Auth, TUS upload, AI, offline sync), Spartan-based UI, SSR server helpers and Playwright helpers",
  "keywords": [
    "angular",
    "angular-library",
    "better-auth",
    "lenne.tech",
    "nest-server",
    "signals",
    "spartan",
    "ssr",
    "tailwindcss"
  ],
  "homepage": "https://github.com/lenneTech/ng-base#readme",
  "bugs": {
    "url": "https://github.com/lenneTech/ng-base/issues"
  },
  "license": "MIT",
  "author": "lenne.Tech <info@lenne.tech> (https://lenne.tech)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lenneTech/ng-base.git"
  },
  "sideEffects": false,
  "exports": {
    "./ui/styles/*": {
      "style": "./ui/styles/*",
      "default": "./ui/styles/*"
    },
    "./i18n/*": {
      "default": "./i18n/*"
    }
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "tslib": "^2.9.1"
  },
  "peerDependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.0",
    "@better-auth/passkey": ">=1.7.16 <1.8.0",
    "@ng-icons/core": ">=36.0.0",
    "@ng-icons/lucide": ">=36.0.0",
    "@playwright/test": ">=1.0.0",
    "@spartan-ng/brain": ">=1.9.0 <2.0.0",
    "better-auth": ">=1.7.16 <1.8.0",
    "modern-screenshot": ">=4.6.0",
    "rxjs": "^7.8.0",
    "tus-js-client": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/ssr": {
      "optional": true
    },
    "@better-auth/passkey": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    },
    "modern-screenshot": {
      "optional": true
    },
    "tus-js-client": {
      "optional": true
    }
  }
}
